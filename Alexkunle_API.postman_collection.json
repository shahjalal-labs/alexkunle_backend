{
  "info": {
    "name": "Alexkunle API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login With Email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"fcmToken\": \"optional-fcm-token\"\n}"
            },
            "url": "{{baseUrl}}/auth/email-login"
          },
          "response": []
        },
        {
          "name": "Login With Phone",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+15555550123\",\n  \"password\": \"password123\",\n  \"fcmToken\": \"optional-fcm-token\"\n}"
            },
            "url": "{{baseUrl}}/auth/phone-login"
          },
          "response": []
        },
        {
          "name": "Get My Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/auth/profile"
          },
          "response": []
        },
        {
          "name": "Send Forgot Password OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/forget-password"
          },
          "response": []
        },
        {
          "name": "Verify Forgot Password OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-otp"
          },
          "response": []
        },
        {
          "name": "Reset Password (Authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"newPassword123\"\n}"
            },
            "url": "{{baseUrl}}/auth/reset-password"
          },
          "response": []
        },
        {
          "name": "Update Profile (Authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullName", "value": "Jane Doe", "type": "text" },
                { "key": "gender", "value": "MALE", "type": "text" },
                { "key": "address", "value": "Dhaka", "type": "text" },
                { "key": "referCode", "value": "REF1234", "type": "text" },
                { "key": "businessName", "value": "My Brand", "type": "text" },
                { "key": "coverPhoto", "type": "file", "src": "" },
                { "key": "NIDFront", "type": "file", "src": "" },
                { "key": "NIDBack", "type": "file", "src": "" },
                { "key": "tradeLicense", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/auth/profile"
          },
          "response": []
        },
        {
          "name": "Change Password (Authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newPassword123\"\n}"
            },
            "url": "{{baseUrl}}/auth/change-password"
          },
          "response": []
        },
        {
          "name": "Delete Account (Authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "DELETE",
            "url": "{{baseUrl}}/auth/delete-account"
          },
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Create User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/user/create"
          },
          "response": []
        },
        {
          "name": "Signup Verification",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"1234\"\n}"
            },
            "url": "{{baseUrl}}/user/signup-verification"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Category",
      "item": [
        {
          "name": "Create Category (Authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\"\n}"
            },
            "url": "{{baseUrl}}/category/create"
          },
          "response": []
        },
        {
          "name": "Get All Categories",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/category"
          },
          "response": []
        },
        {
          "name": "Get Category By Id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/category/:id"
          },
          "response": []
        },
        {
          "name": "Update Category",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\"\n}"
            },
            "url": "{{baseUrl}}/category/:id"
          },
          "response": []
        },
        {
          "name": "Delete Category",
          "request": {
            "auth": { "type": "noauth" },
            "method": "DELETE",
            "url": "{{baseUrl}}/category/:id"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" }
  ]
}
